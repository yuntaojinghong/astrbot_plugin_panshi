        "type": "int",
        "default": 100,
        "slider": {
          "min": 0,
          "max": 1000,
          "step": 50
        },
        "hint": "奴隶每次获得积分时，按此比例分给主人（默认 10%）。设 0 则不分成。"
      },
      "contract_label": {
        "description": "卖身契身份标签",
