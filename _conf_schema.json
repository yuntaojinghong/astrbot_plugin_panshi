{
  "basic": {
    "description": "基础设置",
    "type": "object",
    "items": {
      "super_admins": {
        "description": "插件超级管理员 QQ 号列表",
        "type": "list",
        "default": [],
        "hint": "这些用户在本插件中拥有最高权限（高于群主）"
      },
      "default_ban_time": {
        "description": "默认禁言时长（秒）",
        "type": "int",
        "default": 60,
        "slider": {
          "min": 0,
          "max": 2592000,
          "step": 60
        },
        "hint": "执行禁言且未指定时长时使用"
      },
      "max_ban_time": {
        "description": "单次最大禁言时长（秒）",
        "type": "int",
        "default": 2592000,
        "slider": {
          "min": 60,
          "max": 2592000,
          "step": 3600
        },
        "hint": "30 天，防止误操作超长禁言"
      },
      "enable_groups": {
        "description": "启用本插件的群号列表",
        "type": "list",
        "default": [],
        "hint": "留空或包含 'all' 表示对所有群生效"
      },
      "operation_notice": {
        "description": "执行管理操作后在群内播报结果",
        "type": "bool",
        "default": true
      },
      "anon_protect": {
        "description": "豁免匿名转述内容（避免误禁匿名身份）",
        "type": "bool",
        "default": true,
        "hint": "开启后，本插件不会对「匿名树洞」等插件转述到群里的内容做禁言处罚，避免把匿名身份一并禁言"
      },
      "anon_nicknames": {
        "description": "匿名昵称池（命中即视为匿名转述，予以豁免）",
        "type": "list",
        "default": [],
        "hint": "填写匿名树洞设置的昵称池，如：番茄、苹果、橘子。留空时仅按「【xxx】」格式识别"
      }
    }
  },
  "guard": {
    "description": "反垃圾防护",
    "type": "object",
    "items": {
      "forbidden_enable": {
        "description": "启用违禁词检测",
        "type": "bool",
        "default": true
      },
      "forbidden_words": {
        "description": "违禁词列表",
        "type": "list",
        "default": [],
        "hint": "支持普通词与正则（以 re: 开头，如 re:\\d{11}）"
      },
      "forbidden_builtin": {
        "description": "启用内置违禁词",
        "type": "bool",
        "default": true,
        "hint": "内置广告、政治敏感等常见词库"
      },
      "forbidden_ban_time": {
        "description": "违禁词触发禁言时长（秒）",
        "type": "int",
        "default": 600,
        "slider": {
          "min": 0,
          "max": 2592000,
          "step": 60
        },
        "hint": "0 表示仅撤回不禁言"
      },
      "spam_enable": {
        "description": "启用刷屏检测",
        "type": "bool",
        "default": true
      },
      "spam_count": {
        "description": "刷屏判定：时间窗内消息条数",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 2,
          "max": 20,
          "step": 1
        },
        "hint": "在下方时间窗内发送超过这么多条消息即判定为刷屏"
      },
      "spam_window": {
        "description": "刷屏判定：时间窗（秒）",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 1,
          "max": 60,
          "step": 1
        }
      },
      "spam_ban_time": {
        "description": "刷屏触发禁言时长（秒）",
        "type": "int",
        "default": 300,
        "slider": {
          "min": 0,
          "max": 2592000,
          "step": 60
        }
      },
      "ad_enable": {
        "description": "启用广告链接拦截",
        "type": "bool",
        "default": true
      },
      "repeat_enable": {
        "description": "启用复读打断",
        "type": "bool",
        "default": false,
        "hint": "连续多人复读同一内容时打断"
      },
      "repeat_count": {
        "description": "复读判定人数阈值",
        "type": "int",
        "default": 4,
        "slider": {
          "min": 2,
          "max": 10,
          "step": 1
        }
      },
      "whitelist": {
        "description": "风控白名单（豁免防护处罚的 QQ 号）",
        "type": "list",
        "default": [],
        "hint": "名单内的用户不会被违禁词/刷屏/广告等规则处罚（如官方客服号）"
      }
    }
  },
  "welcome": {
    "description": "入群欢迎",
    "type": "object",
    "items": {
      "welcome_enable": {
        "description": "启用入群欢迎",
        "type": "bool",
        "default": true
      },
      "welcome_templates": {
        "description": "欢迎语文案模板（随机选取一条）",
        "type": "list",
        "default": [
          "欢迎 {at} 加入本群！你是第 {人数} 位成员～",
          "{at} 你好呀，欢迎来到「{群名}」，有问题随时提问～"
        ],
        "hint": "可用变量：{at} {昵称} {群名} {人数} {时间}"
      },
      "welcome_image": {
        "description": "欢迎图片 URL（可选）",
        "type": "string",
        "default": ""
      },
      "welcome_delay": {
        "description": "欢迎语延迟发送（秒）",
        "type": "int",
        "default": 1,
        "slider": {
          "min": 0,
          "max": 60,
          "step": 1
        },
        "hint": "避免与验证消息冲突，0 表示立即"
      },
      "verify_enable": {
        "description": "启用入群算术验证",
        "type": "bool",
        "default": false,
        "hint": "新人需答对算术题才通过，超时自动拒绝"
      },
      "verify_timeout": {
        "description": "验证超时时间（秒）",
        "type": "int",
        "default": 120,
        "slider": {
          "min": 30,
          "max": 600,
          "step": 10
        }
      },
      "join_ban_time": {
        "description": "新成员入群自动禁言时长（秒）",
        "type": "int",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 86400,
          "step": 60
        },
        "hint": "0 表示不禁言"
      },
      "leave_notify": {
        "description": "启用退群通知",
        "type": "bool",
        "default": true
      },
      "leave_block": {
        "description": "退群后自动拉黑",
        "type": "bool",
        "default": false
      },
      "join_review_enable": {
        "description": "启用进群申请审核",
        "type": "bool",
        "default": false
      },
      "join_accept_words": {
        "description": "自动批准关键词",
        "type": "list",
        "default": []
      },
      "join_reject_words": {
        "description": "自动拒绝关键词",
        "type": "list",
        "default": []
      },
      "join_no_match_reject": {
        "description": "未命中白词时自动拒绝",
        "type": "bool",
        "default": false
      }
    }
  },
  "warning": {
    "description": "警告系统",
    "type": "object",
    "items": {
      "warning_enable": {
        "description": "启用警告系统",
        "type": "bool",
        "default": true
      },
      "warn_ban_threshold": {
        "description": "警告达此次数自动禁言",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        }
      },
      "warn_ban_time": {
        "description": "自动禁言时长（秒）",
        "type": "int",
        "default": 3600,
        "slider": {
          "min": 60,
          "max": 2592000,
          "step": 60
        }
      },
      "warn_kick_threshold": {
        "description": "警告达此次数自动踢出",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 0,
          "max": 20,
          "step": 1
        },
        "hint": "0 表示不自动踢出"
      },
      "warn_expire_days": {
        "description": "警告记录有效期（天）",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 0,
          "max": 365,
          "step": 1
        },
        "hint": "超过有效期自动清除，0 表示永久"
      },
      "escalation_ladder": {
        "description": "渐进式处罚阶梯（可选，留空则用阈值配置）",
        "type": "text",
        "default": "",
        "hint": "每行一条：次数|动作|时长秒。动作可选 warn/ban/kick。示例：3|ban|600"
      }
    }
  },
  "smart": {
    "description": "智能识别（听得懂人话）",
    "type": "object",
    "items": {
      "smart_enable": {
        "description": "启用智能意图识别",
        "type": "bool",
        "default": true,
        "hint": "关闭后仅响应 /指令，不再理解自然语言"
      },
      "trigger_on_at": {
        "description": "@机器人时启用智能识别",
        "type": "bool",
        "default": true
      },
      "trigger_on_keyword": {
        "description": "消息含管理动作词时启用智能识别",
        "type": "bool",
        "default": true
      },
      "trigger_on_intent": {
        "description": "意图型触发：含「帮我/刷屏/太吵」等软信号时，经本地闸门判定后交给模型",
        "type": "bool",
        "default": true,
        "hint": "这是听懂口语化表达的关键。消息会先过四道本地零成本闸门（上下文佐证/效果动词/否定闲聊/信用额度），通过才调用模型，不再是命中一个词就烧 token。"
      },
      "intent_budget": {
        "description": "智能识别信用额度（每群每小时可调用模型的次数）",
        "type": "int",
        "default": 20,
        "slider": {
          "min": 0,
          "max": 200,
          "step": 5
        },
        "hint": "每群独立计费。额度耗尽后本地规则继续兜底，常用指令不受影响。设为 0 表示不调用模型，只用本地规则。"
      },
      "intent_cooldown": {
        "description": "智能识别冷却时间（秒）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 0,
          "max": 120,
          "step": 1
        },
        "hint": "同一群两次模型调用之间的最小间隔，避免连续刷屏式触发。设 0 关闭冷却。"
      },
      "local_fast_path": {
        "description": "本地规则快速通道：标准句式先本地秒执行，省一次模型调用",
        "type": "bool",
        "default": true,
        "hint": "仅在已配置对话模型时生效。本地认不出来会自动交给模型，不会丢指令。"
      },
      "smart_confirm_dangerous": {
        "description": "高风险操作（踢人/拉黑）需回复确认",
        "type": "bool",
        "default": true,
        "hint": "防止 AI 误判造成不可逆操作"
      },
      "smart_provider_id": {
        "description": "指定用于意图识别的 LLM 供应商 ID",
        "type": "string",
        "default": "",
        "hint": "留空使用 AstrBot 当前的默认对话模型。不知填什么就用插件面板「智能识别」组里的下拉框选择——会自动列出你已配置的模型。"
      },
      "bot_names": {
        "description": "机器人称呼（用于识别在叫机器人）",
        "type": "list",
        "default": [
          "磐石",
          "群管"
        ]
      },
      "plugin_hint_enable": {
        "description": "插件功能兜底应答（不让模型编）",
        "type": "bool",
        "default": true,
        "hint": "开启后，像指令或在问插件功能、但插件没认出具体动作的消息，由插件自己回一屏真实状态（就是 /面板 的内容）。避免模型一本正经地编「积分插件还没启用」。与别家插件指令撞车时可关掉。"
      }
    }
  },
  "activity": {
    "description": "群积分",
    "type": "object",
    "items": {
      "checkin_enable": {
        "description": "启用签到",
        "type": "bool",
        "default": true
      },
      "checkin_points": {
        "description": "每次签到基础积分",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 1,
          "max": 500,
          "step": 1
        }
      },
      "checkin_random_bonus": {
        "description": "签到随机额外积分上限",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 500,
          "step": 1
        }
      },
      "points_shared": {
        "description": "积分跨群共用（所有群共用一份积分）",
        "type": "bool",
        "default": false,
        "hint": "开启后所有群共用同一份积分，签到每天只能签一次（多群签到不再重复得分），违规扣分也跨群生效。切换后积分从零重算，历史分保留在各自群里、切回来仍在。"
      },
      "checkin_streak_bonus": {
        "description": "连续签到每天额外积分（连签加成）",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "hint": "连签第 2 天加 1 份、第 3 天加 2 份，以此类推。断签重新从第 1 天算。设 0 关闭。"
      },
      "checkin_streak_bonus_cap": {
        "description": "连签加成封顶积分",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 0,
          "max": 500,
          "step": 5
        },
        "hint": "连签加成最多加到这么多分，避免连签一个月后数额失控。"
      },
      "checkin_first_bonus": {
        "description": "当天第一个签到额外奖励（早鸟奖）",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 0,
          "max": 200,
          "step": 1
        },
        "hint": "每天第一个签到的人额外得这么多分，制造「抢」的乐趣。设 0 关闭。"
      },
      "chat_points_enable": {
        "description": "启用发言得积分",
        "type": "bool",
        "default": false,
        "hint": "默认关闭。开启后有效发言可得积分，带冷却与每日上限——没有这两道闸，刷屏脚本就能把分刷满。"
      },
      "chat_points_value": {
        "description": "每条有效发言奖励积分",
        "type": "int",
        "default": 1,
        "slider": {
          "min": 0,
          "max": 50,
          "step": 1
        }
      },
      "chat_points_cooldown": {
        "description": "发言得分冷却（秒）",
        "type": "int",
        "default": 60,
        "slider": {
          "min": 0,
          "max": 600,
          "step": 10
        }
      },
      "chat_points_daily_cap": {
        "description": "每人每天发言得分上限",
        "type": "int",
        "default": 50,
        "slider": {
          "min": 0,
          "max": 2000,
          "step": 10
        }
      },
      "chat_points_min_len": {
        "description": "计入发言的最少字数",
        "type": "int",
        "default": 4,
        "slider": {
          "min": 0,
          "max": 50,
          "step": 1
        },
        "hint": "太短的消息（嗯、哈哈）不计分，也顺手过滤了裸词快捷消息。"
      },
      "chat_first_bonus": {
        "description": "每日首次发言额外积分",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 0,
          "max": 200,
          "step": 1
        }
      },
      "newbie_bonus": {
        "description": "新人礼包（入群后第一次发言）",
        "type": "int",
        "default": 20,
        "slider": {
          "min": 0,
          "max": 500,
          "step": 5
        },
        "hint": "每人只发一次，鼓励新人冒泡。设 0 关闭。"
      },
      "negative_kick_at": {
        "description": "负积分踢人阈值（积扣到该分数就移出群，0=不踢）",
        "type": "int",
        "default": 0,
        "slider": {
          "min": -1000,
          "max": 0,
          "step": 10
        },
        "hint": "默认 0：积分不会被扣成负数。想做「刷屏扣分，扣到 -100 直接踢群」就填 -100（负数）。填 0 表示不启用负积分，扣分最低到 0 分。"
      }
    },
    "hint": "签到与积分规则。积分商城、抽奖、违规扣分在顶栏的「🛒 商品」和「🎰 抽奖」两个页面里配置。"
  },
  "game": {
    "description": "小游戏",
    "type": "object",
    "items": {
      "guess_enable": {
        "description": "启用猜数字",
        "type": "bool",
        "default": true,
        "hint": "群里发「猜数字」开局，谁先猜中谁得分。有冷却与每日发奖局数上限，不会无限发分。"
      },
      "guess_reward": {
        "description": "猜中奖励积分",
        "type": "int",
        "default": 20,
        "slider": {
          "min": 0,
          "max": 500,
          "step": 1
        }
      },
      "guess_daily_games": {
        "description": "每群每天发奖局数上限",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 200,
          "step": 1
        }
      },
      "guess_cooldown": {
        "description": "猜数字开局冷却（秒）",
        "type": "int",
        "default": 60,
        "slider": {
          "min": 0,
          "max": 600,
          "step": 10
        }
      },
      "dice_enable": {
        "description": "启用摇骰子",
        "type": "bool",
        "default": true,
        "hint": "群里发「摇骰子」或「摇骰子 3」即可。纯娱乐，不影响积分。"
      },
      "rps_enable": {
        "description": "启用猜拳",
        "type": "bool",
        "default": true,
        "hint": "群里发「猜拳石头 / 猜拳剪刀 / 猜拳布」与机器人猜拳。纯娱乐，不影响积分。"
      },
      "bet_enable": {
        "description": "启用押注（与机器人比骰子大小）",
        "type": "bool",
        "default": false,
        "hint": "默认关闭。开启后发「押注 10」可押积分比骰子：赢 +N、输 -N、平局退还；有单次与每日净输上限。"
      },
      "bet_max": {
        "description": "单次押注上限",
        "type": "int",
        "default": 20,
        "slider": {
          "min": 1,
          "max": 1000,
          "step": 1
        }
      },
      "bet_daily_loss": {
        "description": "每人每天最多净输积分",
        "type": "int",
        "default": 100,
        "slider": {
          "min": 0,
          "max": 10000,
          "step": 10
        }
      },
      "sanguanwu_enable": {
        "description": "启用三公五（机器人坐庄的积分牌局）",
        "type": "bool",
        "default": false,
        "hint": "默认关闭。开启后发「三公五」开桌，2~3 名群友入座，机器人坐庄发牌比大小，赢家通吃。纯积分娱乐，有单局与每日亏损上限。"
      },
      "sanguanwu_entry": {
        "description": "三公五底注（每人每局最少投入）",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 1,
          "max": 500,
          "step": 1
        }
      },
      "sanguanwu_max_bet": {
        "description": "三公五单局封顶（每人每局最多投入）",
        "type": "int",
        "default": 200,
        "slider": {
          "min": 1,
          "max": 5000,
          "step": 10
        },
        "hint": "防止一局把 someone's 积分全部押进去。"
      },
      "sanguanwu_daily_loss": {
        "description": "三公五每人每日净亏上限",
        "type": "int",
        "default": 300,
        "slider": {
          "min": 0,
          "max": 10000,
          "step": 50
        },
        "hint": "当天累计输到上限后就不能再入座，设 0 表示不限制。"
      },
      "sanguanwu_seats": {
        "description": "三公五每局闲家人数（不含机器人庄家）",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 1,
          "max": 3,
          "step": 1
        },
        "hint": "1=单挑机器人；2=三公五标准局（机器人庄 + 2 闲）；3=再加一个人。"
      },
      "sanguanwu_turn_seconds": {
        "description": "三公五每步操作时限（秒）",
        "type": "int",
        "default": 60,
        "slider": {
          "min": 15,
          "max": 300,
          "step": 5
        },
        "hint": "超时自动按当前状态结算，避免一桌人挂着不退。"
      }
    },
    "hint": "群内小游戏。所有触发词都是整句精确匹配，不会抢群里的正常聊天；猜数字只在有局进行中时才吃数字。"
  },
  "automate": {
    "description": "自动化",
    "type": "object",
    "items": {
      "curfew_enable": {
        "description": "启用宵禁",
        "type": "bool",
        "default": false
      },
      "curfew_start": {
        "description": "宵禁开始时间 HH:MM",
        "type": "string",
        "default": "23:00"
      },
      "curfew_end": {
        "description": "宵禁结束时间 HH:MM",
        "type": "string",
        "default": "07:00"
      },
      "curfew_ban_time": {
        "description": "宵禁期间违规禁言时长（秒）",
        "type": "int",
        "default": 600,
        "slider": {
          "min": 60,
          "max": 2592000,
          "step": 60
        }
      },
      "announce_enable": {
        "description": "启用定时公告",
        "type": "bool",
        "default": false
      },
      "announce_interval_minutes": {
        "description": "定时公告间隔（分钟）",
        "type": "int",
        "default": 360,
        "slider": {
          "min": 10,
          "max": 1440,
          "step": 10
        }
      },
      "announce_content": {
        "description": "定时公告内容",
        "type": "string",
        "default": ""
      },
      "defense_enable": {
        "description": "自主还手（被 @ 辱骂时允许机器人自己处置）",
        "type": "bool",
        "default": false,
        "hint": "默认关闭。开启后：只有当被处置的人就是骂机器人的人、且那条消息 @ 了机器人时，机器人才会绕过「发送者须为管理员」的门槛自己动手。群友想让机器人去打别人（@机器人 把张三禁了）不会被放行。注意机器人需为群管理员或群主，否则协议端仍会拒绝。"
      },
      "defense_mode": {
        "description": "自主还手方式",
        "type": "string",
        "default": "warn",
        "options": [
          "warn",
          "ban"
        ],
        "hint": "warn = 记一次警告（推荐，警告累计到阈值会自动升级为禁言/踢出）；ban = 直接禁言，时长见下一项。"
      },
      "defense_ban_seconds": {
        "description": "自主还手直接禁言的时长（秒）",
        "type": "int",
        "default": 600,
        "hint": "仅在「自主还手方式」选 ban 时生效。"
      },
      "defense_cooldown_seconds": {
        "description": "两次自主还手之间的最短间隔（秒）",
        "type": "int",
        "default": 300,
        "hint": "防止有人反复挑衅让机器人连续动手。"
      },
      "defense_daily_limit": {
        "description": "每个群每天的自主还手上限（次）",
        "type": "int",
        "default": 5,
        "hint": "超过上限当天不再自主处置，避免机器人变成一把可反复使用的刀。"
      }
    }
  },
  "interact": {
    "description": "互动工具",
    "type": "object",
    "items": {
      "vote_enable": {
        "description": "启用群投票",
        "type": "bool",
        "default": true
      },
      "chain_enable": {
        "description": "启用群接龙",
        "type": "bool",
        "default": true
      },
      "self_query_enable": {
