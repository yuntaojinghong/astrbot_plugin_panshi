{
  "basic": {
    "description": "基础设置",
    "type": "object",
    "items": {
      "super_admins": {
        "description": "插件超级管理员 QQ 号列表",
        "type": "list",
        "default": [],
        "hint": "这些用户在本插件中拥有最高权限（高于群主）"
      },
      "default_ban_time": {
        "description": "默认禁言时长（秒）",
        "type": "int",
        "default": 60,
        "slider": {
          "min": 0,
          "max": 2592000,
          "step": 60
        },
        "hint": "执行禁言且未指定时长时使用"
      },
      "max_ban_time": {
        "description": "单次最大禁言时长（秒）",
        "type": "int",
        "default": 2592000,
        "slider": {
          "min": 60,
          "max": 2592000,
          "step": 3600
        },
        "hint": "30 天，防止误操作超长禁言"
      },
      "enable_groups": {
        "description": "启用本插件的群号列表",
        "type": "list",
        "default": [],
        "hint": "留空或包含 'all' 表示对所有群生效"
      },
      "operation_notice": {
        "description": "执行管理操作后在群内播报结果",
        "type": "bool",
        "default": true
      },
      "anon_protect": {
        "description": "豁免匿名转述内容（避免误禁匿名身份）",
        "type": "bool",
        "default": true,
        "hint": "开启后，本插件不会对「匿名树洞」等插件转述到群里的内容做禁言处罚，避免把匿名身份一并禁言"
      },
      "anon_nicknames": {
        "description": "匿名昵称池（命中即视为匿名转述，予以豁免）",
        "type": "list",
        "default": [],
        "hint": "填写匿名树洞设置的昵称池，如：番茄、苹果、橘子。留空时仅按「【xxx】」格式识别"
      }
    }
  },
  "guard": {
    "description": "反垃圾防护",
    "type": "object",
    "items": {
      "forbidden_enable": {
        "description": "启用违禁词检测",
        "type": "bool",
        "default": true
      },
      "forbidden_words": {
        "description": "违禁词列表",
        "type": "list",
        "default": [],
        "hint": "支持普通词与正则（以 re: 开头，如 re:\\d{11}）"
      },
      "forbidden_builtin": {
        "description": "启用内置违禁词",
        "type": "bool",
        "default": true,
        "hint": "内置广告、政治敏感等常见词库"
      },
      "forbidden_ban_time": {
        "description": "违禁词触发禁言时长（秒）",
        "type": "int",
        "default": 600,
        "slider": {
          "min": 0,
          "max": 2592000,
          "step": 60
        },
        "hint": "0 表示仅撤回不禁言"
      },
      "spam_enable": {
        "description": "启用刷屏检测",
        "type": "bool",
        "default": true
      },
      "spam_count": {
        "description": "刷屏判定：时间窗内消息条数",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 2,
          "max": 20,
          "step": 1
        },
        "hint": "在下方时间窗内发送超过这么多条消息即判定为刷屏"
      },
      "spam_window": {
        "description": "刷屏判定：时间窗（秒）",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 1,
          "max": 60,
          "step": 1
        }
      },
      "spam_ban_time": {
        "description": "刷屏触发禁言时长（秒）",
        "type": "int",
        "default": 300,
        "slider": {
          "min": 0,
          "max": 2592000,
          "step": 60
        }
      },
      "ad_enable": {
        "description": "启用广告链接拦截",
        "type": "bool",
        "default": true
      },
      "repeat_enable": {
        "description": "启用复读打断",
        "type": "bool",
        "default": false,
        "hint": "连续多人复读同一内容时打断"
      },
      "repeat_count": {
        "description": "复读判定人数阈值",
        "type": "int",
        "default": 4,
        "slider": {
          "min": 2,
          "max": 10,
          "step": 1
        }
      },
      "whitelist": {
        "description": "风控白名单（豁免防护处罚的 QQ 号）",
        "type": "list",
        "default": [],
        "hint": "名单内的用户不会被违禁词/刷屏/广告等规则处罚（如官方客服号）"
      }
    }
  },
  "welcome": {
    "description": "入群欢迎",
    "type": "object",
    "items": {
      "welcome_enable": {
        "description": "启用入群欢迎",
        "type": "bool",
        "default": true
      },
      "welcome_templates": {
        "description": "欢迎语文案模板（随机选取一条）",
        "type": "list",
        "default": [
          "欢迎 {at} 加入本群！你是第 {人数} 位成员～",
          "{at} 你好呀，欢迎来到「{群名}」，有问题随时提问～"
        ],
        "hint": "可用变量：{at} {昵称} {群名} {人数} {时间}"
      },
      "welcome_image": {
        "description": "欢迎图片 URL（可选）",
        "type": "string",
        "default": ""
      },
      "welcome_delay": {
        "description": "欢迎语延迟发送（秒）",
        "type": "int",
        "default": 1,
        "slider": {
          "min": 0,
          "max": 60,
          "step": 1
        },
        "hint": "避免与验证消息冲突，0 表示立即"
      },
      "verify_enable": {
        "description": "启用入群算术验证",
        "type": "bool",
        "default": false,
        "hint": "新人需答对算术题才通过，超时自动拒绝"
      },
      "verify_timeout": {
        "description": "验证超时时间（秒）",
        "type": "int",
        "default": 120,
        "slider": {
          "min": 30,
          "max": 600,
          "step": 10
        }
      },
      "join_ban_time": {
        "description": "新成员入群自动禁言时长（秒）",
        "type": "int",
        "default": 0,
        "slider": {
          "min": 0,
          "max": 86400,
          "step": 60
        },
        "hint": "0 表示不禁言"
      },
      "leave_notify": {
        "description": "启用退群通知",
        "type": "bool",
        "default": true
      },
      "leave_block": {
        "description": "退群后自动拉黑",
        "type": "bool",
        "default": false
      },
      "join_review_enable": {
        "description": "启用进群申请审核",
        "type": "bool",
        "default": false
      },
      "join_accept_words": {
        "description": "自动批准关键词",
        "type": "list",
        "default": []
      },
      "join_reject_words": {
        "description": "自动拒绝关键词",
        "type": "list",
        "default": []
      },
      "join_no_match_reject": {
        "description": "未命中白词时自动拒绝",
        "type": "bool",
        "default": false
      }
    }
  },
  "warning": {
    "description": "警告系统",
    "type": "object",
    "items": {
      "warning_enable": {
        "description": "启用警告系统",
        "type": "bool",
        "default": true
      },
      "warn_ban_threshold": {
        "description": "警告达此次数自动禁言",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 1,
          "max": 20,
          "step": 1
        }
      },
      "warn_ban_time": {
        "description": "自动禁言时长（秒）",
        "type": "int",
        "default": 3600,
        "slider": {
          "min": 60,
          "max": 2592000,
          "step": 60
        }
      },
      "warn_kick_threshold": {
        "description": "警告达此次数自动踢出",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 0,
          "max": 20,
          "step": 1
        },
        "hint": "0 表示不自动踢出"
      },
      "warn_expire_days": {
        "description": "警告记录有效期（天）",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 0,
          "max": 365,
          "step": 1
        },
        "hint": "超过有效期自动清除，0 表示永久"
      },
      "escalation_ladder": {
        "description": "渐进式处罚阶梯（可选，留空则用阈值配置）",
        "type": "text",
        "default": "",
        "hint": "每行一条：次数|动作|时长秒。动作可选 warn/ban/kick。示例：3|ban|600"
      }
    }
  },
  "smart": {
    "description": "智能识别（听得懂人话）",
    "type": "object",
    "items": {
      "smart_enable": {
        "description": "启用智能意图识别",
        "type": "bool",
        "default": true,
        "hint": "关闭后仅响应 /指令，不再理解自然语言"
      },
      "trigger_on_at": {
        "description": "@机器人时启用智能识别",
        "type": "bool",
        "default": true
      },
      "trigger_on_keyword": {
        "description": "消息含管理动作词时启用智能识别",
        "type": "bool",
        "default": true
      },
      "trigger_on_intent": {
        "description": "意图型触发：含「帮我/刷屏/太吵」等软信号时，经本地闸门判定后交给模型",
        "type": "bool",
        "default": true,
        "hint": "这是听懂口语化表达的关键。消息会先过四道本地零成本闸门（上下文佐证/效果动词/否定闲聊/信用额度），通过才调用模型，不再是命中一个词就烧 token。"
      },
      "intent_budget": {
        "description": "智能识别信用额度（每群每小时可调用模型的次数）",
        "type": "int",
        "default": 20,
        "slider": {
          "min": 0,
          "max": 200,
          "step": 5
        },
        "hint": "每群独立计费。额度耗尽后本地规则继续兜底，常用指令不受影响。设为 0 表示不调用模型，只用本地规则。"
      },
      "intent_cooldown": {
        "description": "智能识别冷却时间（秒）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 0,
          "max": 120,
          "step": 1
        },
        "hint": "同一群两次模型调用之间的最小间隔，避免连续刷屏式触发。设 0 关闭冷却。"
      },
      "local_fast_path": {
        "description": "本地规则快速通道：标准句式先本地秒执行，省一次模型调用",
        "type": "bool",
        "default": true,
        "hint": "仅在已配置对话模型时生效。本地认不出来会自动交给模型，不会丢指令。"
      },
      "smart_confirm_dangerous": {
        "description": "高风险操作（踢人/拉黑）需回复确认",
        "type": "bool",
        "default": true,
        "hint": "防止 AI 误判造成不可逆操作"
      },
      "smart_provider_id": {
        "description": "指定用于意图识别的 LLM 供应商 ID",
        "type": "string",
        "default": "",
        "hint": "留空使用 AstrBot 当前的默认对话模型。不知填什么就用插件面板「智能识别」组里的下拉框选择——会自动列出你已配置的模型。"
      },
      "bot_names": {
        "description": "机器人称呼（用于识别在叫机器人）",
        "type": "list",
        "default": [
          "磐石",
          "群管"
        ]
      }
    }
  },
  "activity": {
    "description": "群活跃",
    "type": "object",
    "items": {
      "checkin_enable": {
        "description": "启用签到",
        "type": "bool",
        "default": true
      },
      "checkin_points": {
        "description": "每次签到基础积分",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 1,
          "max": 500,
          "step": 1
        }
      },
      "checkin_random_bonus": {
        "description": "签到随机额外积分上限",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 0,
          "max": 500,
          "step": 1
        }
      }
    }
  },
  "shop": {
    "description": "积分商城与抽奖",
    "type": "object",
    "items": {
      "enable": {
        "description": "启用积分商城",
        "type": "bool",
        "default": false,
        "hint": "开启后群友可用「/商城」查看、「/购买 <商品名>」下单，积分来自签到与发言奖励。\n可以按群单独关闭：管理员在本群发「/积分开关 off」即可，关闭后本群不显示商城、不能购买与抽奖，也不再扣违规积分。"
      },
      "items": {
        "description": "商品列表",
        "type": "list",
        "default": [
          {
            "id": "title_7d",
            "name": "7天专属头衔",
            "cost": 200,
            "description": "自定义群头衔，7天后可再买",
            "stock": 0,
            "limit_per_user": 1,
            "limit_per_day": 0,
            "reward": "title",
            "value": "群宠"
          },
          {
            "id": "points_100",
            "name": "100积分补给包",
            "cost": 80,
            "description": "用 80 积分换 100 积分（每人每天一次）",
            "stock": -1,
            "limit_per_user": 0,
            "limit_per_day": 1,
            "reward": "points",
            "value": "100"
          }
        ],
        "hint": "每项字段：id（唯一标识，可省略）、name（商品名，必填）、cost（价格）、description（说明）、stock（库存，留空或 -1 = 不限量，0 = 售罄）、limit_per_user（每人限购，0 = 不限）、limit_per_day（每日限购，0 = 不限）、reward（发放方式）、value（发放内容）、enabled（是否上架）。"
      },
      "lottery": {
        "description": "抽奖",
        "type": "object",
        "items": {
          "enable": {
            "description": "启用抽奖",
            "type": "bool",
            "default": false
          },
          "cost": {
            "description": "每次抽奖消耗积分",
            "type": "int",
            "default": 10,
            "slider": {
              "min": 0,
              "max": 500,
              "step": 1
            }
          },
          "daily_limit": {
            "description": "每人每日抽奖次数上限（0 = 不限）",
            "type": "int",
            "default": 3,
            "slider": {
              "min": 0,
              "max": 50,
              "step": 1
            }
          },
          "pity": {
            "description": "保底次数（连续这么多次没中「稀有」就必中，0 = 关闭）",
            "type": "int",
            "default": 10,
            "slider": {
              "min": 0,
              "max": 100,
              "step": 1
            },
            "hint": "只对标记了 rare=是 的奖品生效。保底计数跨天累计。"
          },
          "prizes": {
            "description": "奖池",
            "type": "list",
            "default": [
              {
                "id": "thanks",
                "name": "谢谢参与（未中奖）",
                "weight": 0.0,
                "rare": false,
                "reward": "none",
                "value": ""
              },
              {
                "id": "pts_5",
                "name": "5 积分",
                "weight": 0.3,
                "rare": false,
                "reward": "points",
                "value": "5"
              },
              {
                "id": "pts_50",
                "name": "50 积分",
                "weight": 0.09,
                "rare": false,
                "reward": "points",
                "value": "50"
              },
              {
                "id": "title_rare",
                "name": "限定头衔",
                "weight": 0.01,
                "rare": true,
                "reward": "title",
                "value": "欧皇"
              }
            ],
            "hint": "每项字段：id、name（奖品名，必填）、weight（中奖概率，0~1 的小数）、rare（是否稀有，供保底使用）、reward（points/title/action/manual/none）、value（发放内容）、enabled。\n**所有奖品概率之和不得超过 1**；不足 1 的剩余部分自动成为「未中奖」概率。例如 0.30+0.09+0.01=0.40，则未中奖 60%。\n想要「谢谢参与」这类显式空奖，把它也当成一个奖品即可（reward 选 none）。"
          }
        }
      },
      "penalties": {
        "description": "违规扣积分",
        "type": "list",
        "hint": "每项字段：reason（风控原因，要和风控那侧的叫法一致：刷屏 / 违禁词 / 广告 / 复读）、points（扣多少积分，不会扣成负数）、ban（是否同时禁言，时长仍由「风控」组各自的配置决定）、enabled（是否启用这条）。",
        "default": [
          {
            "reason": "刷屏",
            "points": 20,
            "ban": true,
            "enabled": true
          },
          {
            "reason": "违禁词",
            "points": 50,
            "ban": true,
            "enabled": true
          },
          {
            "reason": "广告",
            "points": 50,
            "ban": true,
            "enabled": true
          },
          {
            "reason": "复读",
            "points": 10,
            "ban": false,
            "enabled": true
          }
        ]
      }
    }
  },
  "automate": {
    "description": "自动化",
    "type": "object",
    "items": {
      "curfew_enable": {
        "description": "启用宵禁",
        "type": "bool",
        "default": false
      },
      "curfew_start": {
        "description": "宵禁开始时间 HH:MM",
        "type": "string",
        "default": "23:00"
      },
      "curfew_end": {
        "description": "宵禁结束时间 HH:MM",
        "type": "string",
        "default": "07:00"
      },
      "curfew_ban_time": {
        "description": "宵禁期间违规禁言时长（秒）",
        "type": "int",
        "default": 600,
        "slider": {
          "min": 60,
          "max": 2592000,
          "step": 60
        }
      },
      "announce_enable": {
        "description": "启用定时公告",
        "type": "bool",
        "default": false
      },
      "announce_interval_minutes": {
        "description": "定时公告间隔（分钟）",
        "type": "int",
        "default": 360,
        "slider": {
          "min": 10,
          "max": 1440,
          "step": 10
        }
      },
      "announce_content": {
        "description": "定时公告内容",
        "type": "string",
        "default": ""
      },
      "defense_enable": {
        "description": "自主还手（被 @ 辱骂时允许机器人自己处置）",
        "type": "bool",
        "default": false,
        "hint": "默认关闭。开启后：只有当被处置的人就是骂机器人的人、且那条消息 @ 了机器人时，机器人才会绕过「发送者须为管理员」的门槛自己动手。群友想让机器人去打别人（@机器人 把张三禁了）不会被放行。注意机器人需为群管理员或群主，否则协议端仍会拒绝。"
      },
      "defense_mode": {
        "description": "自主还手方式",
        "type": "string",
        "default": "warn",
        "options": [
          "warn",
          "ban"
        ],
        "hint": "warn = 记一次警告（推荐，警告累计到阈值会自动升级为禁言/踢出）；ban = 直接禁言，时长见下一项。"
      },
      "defense_ban_seconds": {
        "description": "自主还手直接禁言的时长（秒）",
        "type": "int",
        "default": 600,
        "hint": "仅在「自主还手方式」选 ban 时生效。"
      },
      "defense_cooldown_seconds": {
        "description": "两次自主还手之间的最短间隔（秒）",
        "type": "int",
        "default": 300,
        "hint": "防止有人反复挑衅让机器人连续动手。"
      },
      "defense_daily_limit": {
        "description": "每个群每天的自主还手上限（次）",
        "type": "int",
        "default": 5,
        "hint": "超过上限当天不再自主处置，避免机器人变成一把可反复使用的刀。"
      }
    }
  },
  "interact": {
    "description": "互动工具",
    "type": "object",
    "items": {
      "vote_enable": {
        "description": "启用群投票",
        "type": "bool",
        "default": true
      },
      "chain_enable": {
        "description": "启用群接龙",
        "type": "bool",
        "default": true
      },
      "self_query_enable": {
        "description": "启用自助查询（普通成员可查自己的积分/违规/签到）",
        "type": "bool",
        "default": true
      },
      "auto_reply_enable": {
        "description": "启用关键词自动回复",
        "type": "bool",
        "default": false
      },
      "auto_replies_text": {
        "description": "关键词自动回复规则（每行一条：关键词1,关键词2 => 回复内容）",
        "type": "text",
        "default": "",
        "hint": "示例：群规 => 群规见置顶公告；签到 => 发送 /签到 即可打卡"
      }
    }
  }
}
