        "default": false
      },
      "vote_points": {
        "description": "参与投票奖励积分",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        },
        "hint": "投一票得这么多分。设 0 关闭。积分系统关闭时不发放。"
      },
      "chain_points": {
        "description": "参与接龙奖励积分",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 0,
          "max": 100,
          "step": 1
        }
      },
      "interact_points_daily_cap": {
        "description": "互动得分每人每天上限",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 0,
          "max": 1000,
          "step": 5
        },
        "hint": "投票与接龙共用这一个上限，避免靠反复参与刷分。"
      },
      "auto_replies_text": {
        "description": "关键词自动回复规则（每行一条：关键词1,关键词2 => 回复内容）",
        "type": "text",
        "default": "",
        "hint": "示例：群规 => 群规见置顶公告；签到 => 发送 /签到 即可打卡"
      },
      "bare_word_enable": {
        "description": "启用裸词快捷触发（不打斜杠也能用）",
        "type": "bool",
        "default": true,
        "hint": "开启后直接发「积分」「签到」「积分排行」「积分商城」「抽奖」等词即可。只认整句精确匹配，句中夹着不触发。"
      },
      "bare_word_extra": {
        "description": "裸词自定义（每行一条：关键词 => 动作）",
        "type": "text",
        "default": "",
        "hint": "动作名：points 查积分、checkin 签到、rank 积分排行、rank_msg 发言排行、shop 商城、lottery 抽奖、records 消费记录、self 我的档案、help 帮助。例：宝石 => points"
      }
    }
  },
